@model ProductDto

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="col-lg-7 col-md-9 mx-auto rounded-4 border-0 shadow-lg p-4 bg-white">
        <div class="text-center mb-4">
            <h2 class="fw-bold mb-1">Edit Product</h2>
            <p class="text-muted mb-0">Update product details and save your changes.</p>
        </div>
        <hr />
        <form method="post" enctype="multipart/form-data" autocomplete="off">
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Id</label>
                <div class="col-sm-8">
                    <input class="form-control-plaintext" readonly value="@ViewData["ProductId"]">
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Name</label>
                <div class="col-sm-8">
                    <input class="form-control form-control-lg" asp-for="Name" placeholder="Product Name">
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Model</label>
                <div class="col-sm-8">
                    <input class="form-control form-control-lg" asp-for="Brand" placeholder="Model">
                    <span asp-validation-for="Brand" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Category</label>
                <div class="col-sm-8">
                    <select class="form-select form-select-lg" asp-for="Category">
                        <option value='Other'>Other</option>
                        <option value='GeForce RTX Series'>GeForce RTX Series</option>
                        <option value='Quadro'>Quadro</option>
                        <option value='NVIDIA MX '>NVIDIA MX </option>
                        <option value='Tesla'>Tesla</option>
                        <option value='NVIDIA RTX A-Series'>NVIDIA RTX A-Series</option>
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Price</label>
                <div class="col-sm-8">
                    <input class="form-control form-control-lg" asp-for="Price" placeholder="Price">
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control form-control-lg" asp-for="Description" rows="3" placeholder="Description"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3 align-items-center">
                <label class="col-sm-4 col-form-label">Current Image</label>
                <div class="col-sm-8">
                    <img src="/products/@ViewData["ImageFileName"]" width="120" class="rounded-3 shadow-sm bg-light mb-2" alt="Current Product Image">
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">New Image</label>
                <div class="col-sm-8">
                    <input type="file" class="form-control form-control-lg" asp-for="ImageFile">
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Created At</label>
                <div class="col-sm-8">
                    <input class="form-control-plaintext" readonly value="@ViewData["CreatedAt"]">
                </div>
            </div>
            <div class="row">
                <div class="offset-sm-4 col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                </div>
                <div class="col-sm-4 d-grid">
                    <a class="btn btn-outline-primary" asp-controller="Products" asp-action="Index" role="button">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
