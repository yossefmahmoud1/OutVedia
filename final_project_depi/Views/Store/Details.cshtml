@model Product

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4 p-4">
                <div class="row g-4 align-items-center">
                    <div class="col-md-5 text-center">
                        <img src="@(Model.ImageFileName.StartsWith("http") ? Model.ImageFileName : "/products/" + Model.ImageFileName)" class="img-fluid rounded-3 shadow-sm bg-light p-2" alt="@Model.Name" style="max-height: 320px; object-fit: contain;" />
                    </div>
                    <div class="col-md-7">
                        <h2 class="fw-bold mb-2">@Model.Name</h2>
                        <div class="mb-3">
                            <span class="badge bg-primary me-2">@Model.Brand</span>
                            <span class="badge bg-secondary">@Model.Category</span>
                        </div>
                        <h3 class="text-success fw-bold mb-4">$@Model.Price</h3>
                        <button type="button" class="btn btn-warning btn-lg px-4 mb-3" onclick="addToCart(this, @Model.Id)">
                            <i class="bi bi-cart4 me-2"></i>Add to Cart
                        </button>
                        <hr />
                        <div class="mb-2">
                            <span class="fw-bold">Description</span>
                        </div>
                        <div class="text-muted" style="white-space: pre-line">@Model.Description</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
