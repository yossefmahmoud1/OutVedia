@model StoreSearchModel
@{
    ViewData["Title"] = "Store Products";
}

<!-- Hero/Header Section -->
<div class="bg-primary text-white rounded-4 shadow-sm mb-4 p-4 d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center">
        <i class="bi bi-shop-window fs-1 me-3"></i>
        <div>
            <h2 class="fw-bold mb-0">Shop Products</h2>
            <div class="small">Find the best graphics cards for your needs</div>
        </div>
    </div>
</div>

<!-- Filter/Search Bar -->
<form class="row g-3 mb-4 align-items-end bg-light rounded-3 p-3 shadow-sm">
    <div class="col-lg-2 col-md-4">
        <label class="form-label text-muted">Model Year</label>
        <select class="form-select" name="brand" asp-for="Brand" onchange="this.form.submit()">
            <option value="">All Models</option>
            <option value="2020">2020</option>
            <option value="2021">2021</option>
            <option value="2022">2022</option>
            <option value="2023">2023</option>
            <option value="2024">2024</option>
            <option value="2025">2025</option>
        </select>
    </div>
    <div class="col-lg-2 col-md-4">
        <label class="form-label text-muted">Category</label>
        <select class="form-select" name="category" asp-for="Category" onchange="this.form.submit()">
            <option value="">All Categories</option>
            <option value="GeForce RTX Series">GeForce RTX Series</option>
            <option value="Quadro">Quadro</option>
            <option value="NVIDIA MX">NVIDIA MX</option>
            <option value="Tesla">Tesla</option>
        </select>
    </div>
    <div class="col-lg-2 col-md-4">
        <label class="form-label text-muted">Sort By</label>
        <select class="form-select" name="sort" asp-for="Sort" onchange="this.form.submit()">
            <option value="newest">Order By Newest</option>
            <option value="price_asc">Price: Low to High</option>
            <option value="price_desc">Price: High to Low</option>
        </select>
    </div>
    <div class="col-lg-6 col-md-12 d-flex align-items-end">
        <input class="form-control me-2" name="search" asp-for="Search" placeholder="Search by Name">
        <button class="btn btn-primary d-flex align-items-center" type="submit">
            <i class="bi bi-search me-1"></i>Search
        </button>
    </div>
</form>

<!-- Products Grid -->
<div class="row mb-5 g-4">
    @foreach(var product in ViewBag.Products){
        <div class="col-lg-3 col-md-6">
            <div class="card product-card h-100 border-0 shadow-sm rounded-4 p-3 text-center position-relative">
                <div class="bg-light rounded-3 d-flex align-items-center justify-content-center mb-3" style="height: 180px;">
                    <img src="/products/@product.ImageFileName" class="img-fluid" alt="..." style="max-height: 160px; object-fit:contain;"/>
                </div>
                <h5 class="fw-bold mb-2">@product.Name</h5>
                <div class="mb-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary me-1"><i class="bi bi-cpu me-1"></i>@product.Brand</span>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-tags me-1"></i>@product.Category</span>
                </div>
                <h4 class="mb-3 text-success">@(product.Price)$</h4>
                <a class="btn btn-outline-primary btn-sm mb-2 w-100" asp-controller="Store" asp-action="Details" asp-route-id="@product.Id" role="button">
                    <i class="bi bi-info-circle me-1"></i>Details
                </a>
                <button type="button" class="btn btn-warning btn-sm w-100" onclick="addToCart(this, @product.Id)">
                    <i class="bi bi-cart4 me-1"></i>Add to Cart
                </button>
            </div>
        </div>
    }
</div>

<!-- Pagination -->
<nav>
  <ul class="pagination justify-content-center">
    @for(int i=1;i<=ViewBag.TotalPages;i++)
    {
        string active="";
        if(i==ViewBag.pageIndex) active="active";
        <li class="page-item @active"><a class="page-link" asp-route-pageIndex="@i"
           asp-route-search="@Model.Search" asp-route-brand="@Model.Brand" 
            asp-route-category="@Model.Category" asp-route-sort="@Model.Sort">@i</a></li>
    }
  </ul>
</nav>

<!-- Modern Product Card Hover Effect -->
<style>
.product-card {
    transition: transform 0.18s, box-shadow 0.18s;
}
.product-card:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 8px 32px rgba(0, 123, 255, 0.10) !important;
    border-color: #007bff22 !important;
}
</style>
