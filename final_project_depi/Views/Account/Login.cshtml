@model LoginDto

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="col-md-5 col-lg-4 mx-auto rounded-4 border-0 shadow-lg p-4 bg-white">
        <div class="text-center mb-4">
            <img src="/images/icon.jpg" alt="Logo" width="48" class="mb-2 rounded-circle shadow-sm bg-primary p-1" />
            <h2 class="fw-bold mb-1">Sign In</h2>
            <p class="text-muted mb-0">Welcome back! Please login to your account.</p>
        </div>
    <hr />

    @if(ViewBag.ErrorMessage !=null){
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>@ViewBag.ErrorMessage</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
    }
        <form method="post" autocomplete="off">
    <div class="mb-3">
    <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Password" class="form-control form-control-lg" type="password" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
            <div class="form-check mb-3">
                <input asp-for="Remeberme" class="form-check-input" type="checkbox" id="rememberMeCheck" />
                <label class="form-check-label" for="rememberMeCheck">Remember Me</label>
                </div>
            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary btn-lg">Log in</button>
                </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <a asp-controller="Account" asp-action="ForgetPassword" class="btn btn-link p-0">Forgot your Password?</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-sm">Create Account</a>
            </div> 
            <div class="d-grid">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Cancel</a>
            </div>
    </form>
    </div>
</div>
