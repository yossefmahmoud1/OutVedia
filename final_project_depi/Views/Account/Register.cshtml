@model RegisterDto
 
<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="col-lg-6 col-md-8 mx-auto rounded-4 border-0 shadow-lg p-4 bg-white">
        <div class="text-center mb-4">
            <img src="/images/icon.jpg" alt="Logo" width="48" class="mb-2 rounded-circle shadow-sm bg-primary p-1" />
            <h2 class="fw-bold mb-1">Create Account</h2>
            <p class="text-muted mb-0">Join Outvedia and start shopping today!</p>
        </div>
        <hr />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
        <form method="post" autocomplete="off">
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">First Name*</label>
                <div class="col-sm-8">
                    <input class="form-control form-control-lg" asp-for="FirstName" placeholder="First Name">
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Last Name*</label>
                <div class="col-sm-8">
                    <input class="form-control form-control-lg" asp-for="LastName" placeholder="Last Name">
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Email*</label>
                <div class="col-sm-8">
                    <input class="form-control form-control-lg" asp-for="Email" placeholder="Email">
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Phone</label>
                <div class="col-sm-8">
                    <input class="form-control form-control-lg" asp-for="PhoneNumber" placeholder="Phone">
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Address*</label>
                <div class="col-sm-8">
                    <input class="form-control form-control-lg" asp-for="Address" placeholder="Address">
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Password*</label>
                <div class="col-sm-8">
                    <input class="form-control form-control-lg" type="password" asp-for="Password" placeholder="Password">
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Confirm Password*</label>
                <div class="col-sm-8">
                    <input class="form-control form-control-lg" type="password" asp-for="ConfirmPassword" placeholder="Confirm Password">
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="offset-sm-4 col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Register</button>
                </div>
                <div class="col-sm-4 d-grid">
                    <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index" role="button">
                        Cancel
                    </a>
                </div>
            </div>
            <div class="d-flex justify-content-end">
                <a asp-controller="Account" asp-action="Login" class="btn btn-link p-0">Already have an account? Login</a>
            </div>
        </form>
    </div>
</div>










