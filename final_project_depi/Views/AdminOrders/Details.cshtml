@model Order
@{
    string paymentBadgeColor = "bg-danger";
    if (Model.PaymentStatus == "pending")
    {
        paymentBadgeColor = "bg-warning text-dark";
    }
    else if (Model.PaymentStatus == "accepted")
    {
        paymentBadgeColor = "bg-success";
    }
    else if (Model.PaymentStatus == "canceled")
    {
        paymentBadgeColor = "bg-secondary";
    }

    string orderBadgeColor = "bg-danger";
    if (Model.OrderStatus == "created")
    {
        orderBadgeColor = "bg-warning text-dark";
    }
    else if (Model.OrderStatus == "accepted")
    {
        orderBadgeColor = "bg-success";
    }
    else if (Model.OrderStatus == "canceled")
    {
        orderBadgeColor = "bg-secondary";
    }
    else if (Model.OrderStatus == "shipped")
    {
        orderBadgeColor = "bg-primary";
    }
    else if (Model.OrderStatus == "delivered")
    {
        orderBadgeColor = "bg-success";
    }
    else if (Model.OrderStatus == "returned")
    {
        orderBadgeColor = "bg-info text-dark";
    }
    else if (Model.OrderStatus == "deleted")
    {
        orderBadgeColor = "bg-dark";
    }
}

<div class="container py-5">
    <div class="row justify-content-center mb-4">
        <div class="col-lg-11">
            <div class="card shadow-lg border-0 rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold mb-0 text-primary">Order Details</h2>
                    <a class="btn btn-outline-primary" asp-controller="AdminOrders" asp-action="Index">Back to Orders</a>
                </div>
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="bg-light rounded-3 p-3 h-100">
                            <h5 class="fw-bold mb-3">Order Info</h5>
                            <div class="mb-2"><span class="fw-semibold">Order ID:</span> @Model.Id</div>
                            <div class="mb-2"><span class="fw-semibold">Order Date:</span> @Model.CreatedAt.ToString("MM/dd/yyyy")</div>
                            <div class="mb-2"><span class="fw-semibold">Delivery Address:</span> @Model.DeliveryAddress</div>
                            <div class="mb-2"><span class="fw-semibold">Payment Method:</span> @Model.PaymentMethod</div>
                            <div class="mb-2"><span class="fw-semibold">Payment Status:</span> <span class="badge rounded-pill @paymentBadgeColor">@Model.PaymentStatus</span>
                                <a href="#" class="mx-2" data-bs-toggle="modal" data-bs-target="#paymentStatusModal">Edit</a>
                                <a href="#" data-bs-toggle="modal" data-bs-target="#paymentDetailsModal">Details</a>
                            </div>
                            <div class="mb-2"><span class="fw-semibold">Order Status:</span> <span class="badge rounded-pill @orderBadgeColor">@Model.OrderStatus</span>
                                <a href="#" class="ms-2" data-bs-toggle="modal" data-bs-target="#orderStatusModal">Edit</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-light rounded-3 p-3 h-100">
                            <h5 class="fw-bold mb-3">Client Info</h5>
                            <div class="mb-2"><span class="fw-semibold">Name:</span> <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.Client.Id">@(Model.Client.FirstName + " " + Model.Client.LastName)</a></div>
                            <div class="mb-2"><span class="fw-semibold">N° Orders:</span> @ViewBag.NumOrders</div>
                            <div class="mb-2"><span class="fw-semibold">Email:</span> @Model.Client.Email</div>
                            <div class="mb-2"><span class="fw-semibold">Phone:</span> @Model.Client.PhoneNumber</div>
                            <div class="mb-2"><span class="fw-semibold">Address:</span> @Model.Client.Address</div>
                            <div class="mb-2"><span class="fw-semibold">Registered At:</span> @Model.Client.CreatedAt.ToString("MM/dd/yyyy")</div>
                        </div>
                    </div>
                </div>
                <h5 class="fw-bold mb-3 mt-4">Order Items</h5>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 120px">Product</th>
                                <th>Name &amp; Category</th>
                                <th style="width:100px">Units</th>
                                <th style="width:100px">Unit Price</th>
                                <th style="width:100px">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <img src="@(item.Product.ImageFileName.StartsWith("http") ? item.Product.ImageFileName : "/products/" + item.Product.ImageFileName)" width="100" class="rounded-3 shadow-sm bg-white p-1" alt="@item.Product.Name" />
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.Product.Name</div>
                                        <div class="text-muted small">@item.Product.Category</div>
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice$</td>
                                    <td class="fw-bold">@(item.UnitPrice * item.Quantity)$</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end mt-4">
                    <div style="width: 300px;">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-semibold">Subtotal:</span>
                            <span>@(Model.Items.Sum(i => i.UnitPrice * i.Quantity))$</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-semibold">Shipping Fee:</span>
                            <span>@(Model.ShippingFee)$</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2 mt-2">
                            <span class="fw-bold">Total:</span>
                            <span class="fw-bold text-success">@(Model.Items.Sum(i => i.UnitPrice * i.Quantity) + Model.ShippingFee)$</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="paymentStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Update Payment Status</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                
                <form method="get" asp-controller="AdminOrders" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>Payment Status</label>
                    <select class="form-select mb-2" name="payment_status" asp-for="PaymentStatus">
                        <option value="pending">pending</option>
                        <option value="accepted">accepted</option>
                        <option value="canceled">canceled</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="orderStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Update Order Status</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                
                <form method="get" asp-controller="AdminOrders" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>Order Status</label>
                    <select class="form-select mb-2" name="order_status" asp-for="OrderStatus">
                        <option value="created">created</option>
                        <option value="accepted">accepted</option>
                        <option value="canceled">canceled</option>
                        <option value="shipped">shipped</option>
                        <option value="delivered">delivered</option>
                        <option value="returned">returned</option>
                        <option value="deleted">deleted</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="paymentDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Payment Details</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                
                <p style="white-space: pre-wrap; font-family: monospace">@Html.Raw(Model.PaymentDetails)</p>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>